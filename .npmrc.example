# GitHub Packages Configuration (PRIVATE PACKAGES)
# This configuration is required to publish and install @clarity-chat packages

# Point @clarity-chat scoped packages to GitHub Packages
@clarity-chat:registry=https://npm.pkg.github.com

# Authentication token for GitHub Packages
# Replace YOUR_GITHUB_TOKEN with your actual Personal Access Token
# Generate at: https://github.com/settings/tokens
# Required scopes: read:packages, write:packages (for publishing)
//npm.pkg.github.com/:_authToken=YOUR_GITHUB_TOKEN

# Alternative: Use environment variable (recommended for CI/CD)
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# IMPORTANT: Never commit this file with your actual token!
# This file should be in .gitignore
