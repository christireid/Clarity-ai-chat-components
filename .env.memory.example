# AI Memory Infrastructure Configuration
# Copy this file to .env.memory and update with your values

# Qdrant Configuration
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=your-secure-api-key-here

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_MAX_MEMORY=1gb

# PostgreSQL Configuration
POSTGRES_PORT=5432
POSTGRES_DB=clarity_memories
POSTGRES_USER=clarity
POSTGRES_PASSWORD=your-secure-postgres-password

# Debug Tools (optional)
REDIS_COMMANDER_PORT=8081
PGADMIN_PORT=8082
PGADMIN_EMAIL=admin@clarity.chat
PGADMIN_PASSWORD=your-secure-pgadmin-password

# Memory Service Configuration
MEMORY_MAX_CONTEXT_WINDOW=4096
MEMORY_ENABLE_COMPRESSION=true
MEMORY_ENABLE_AUTO_CLEANUP=true
MEMORY_CLEANUP_INTERVAL=3600000
MEMORY_ENABLE_VECTOR_STORE=true
MEMORY_ENABLE_CACHE=true
MEMORY_CACHE_TTL=3600

# OpenAI Configuration (for embeddings)
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cohere Configuration (alternative for embeddings)
COHERE_API_KEY=your-cohere-api-key
