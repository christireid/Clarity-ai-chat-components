{
  "name": "@clarity-chat/codemods",
  "version": "1.0.0",
  "description": "Automated migration tools for Clarity Chat API changes",
  "main": "dist/index.js",
  "bin": {
    "clarity-codemods": "./dist/index.js"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "codemod",
    "migration",
    "clarity-chat",
    "react",
    "typescript"
  ],
  "author": "Clarity Chat Team",
  "license": "MIT",
  "dependencies": {
    "jscodeshift": "^0.15.0"
  },
  "devDependencies": {
    "@clarity-chat/primitives": "workspace:*",
    "@clarity-chat/react": "workspace:*",
    "@types/jscodeshift": "^0.11.6",
    "@types/node": "^22.10.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@clarity-chat/react": "workspace:*",
    "@clarity-chat/primitives": "workspace:*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/clarity-chat/components.git",
    "directory": "packages/codemods"
  },
  "bugs": {
    "url": "https://github.com/clarity-chat/components/issues"
  },
  "homepage": "https://github.com/clarity-chat/components/tree/main/packages/codemods"
}
