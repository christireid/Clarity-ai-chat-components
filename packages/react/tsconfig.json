{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@clarity-chat/primitives": ["../primitives/src/index.ts"],
      "@clarity-chat/primitives/*": ["../primitives/src/*"],
      "@clarity-chat/types": ["../types/src/index.ts"],
      "@clarity-chat/types/*": ["../types/src/*"],
      "@clarity-chat/utils": ["../utils/src/index.ts"],
      "@clarity-chat/utils/*": ["../utils/src/*"],
      "@clarity-chat/memory": ["../memory/src/index.ts"],
      "@clarity-chat/memory/*": ["../memory/src/*"],
      "@clarity-chat/license": ["../license/src/index.ts"],
      "@clarity-chat/license/*": ["../license/src/*"]
    },
    // TODO: Re-enable after fixing ~300 index access errors across codebase
    "noUncheckedIndexedAccess": false,
    // TODO: Re-enable after fixing 12 index signature access errors
    "noPropertyAccessFromIndexSignature": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**",
    "src/utils/memory/examples/**",
    "src/**/*.example.tsx",
    "src/**/*.example.ts",
    "src/prompt/**/*"
  ]
}
