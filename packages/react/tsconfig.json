{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // TODO: Re-enable after fixing ~300 index access errors across codebase
    "noUncheckedIndexedAccess": false,
    // TODO: Re-enable after fixing 12 index signature access errors
    "noPropertyAccessFromIndexSignature": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/examples/**",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/utils/memory/examples/**",
    "src/**/*.example.tsx",
    "src/**/*.example.ts",
    "src/prompt/**/*",
    "src/prompts/**/*",
    "src/components/prompt/**/*",
    "src/components/TokenCountingDemo.tsx",
    "src/components/chat/floating-chat-widget.tsx",
    "src/components/structured-input/**/*",
    "src/utils/tokenization/**/*",
    "src/enterprise/**/*",
    "src/bundle-analyzer/**/*",
    "src/ci-cd/**/*",
    "src/security/**/*",
    "src/hooks/security/**/*",
    "src/utils/security/**/*",
    "src/components/enterprise/**/*",
    "src/domains/**/*",
    "src/exports/chat-ui.ts",
    "src/exports/domains.ts",
    "src/extensions/**/*",
    "src/components/search/**/*",
    "src/components/ui/dashboard-skeleton.tsx",
    "src/components/chat/floating-chat-widget.tsx",
    "src/hooks/chat/use-agent.ts",
    "src/hooks/chat/use-rag-pipeline.ts",
    "src/hooks/chat/use-chat-unified.ts",
    "src/hooks/streaming/use-streaming-chat.ts",
    "src/hooks/keyboard/use-command-palette-commands.ts",
    "src/hooks/performance/**/*",
    "src/hooks/input/use-realistic-typing.ts",
    "src/hooks/use-quantum-voice.ts",
    "src/integrations/**/*",
    "src/plugins/**/*",
    "src/safety/**/*",
    "src/templates/**/*",
    "src/typescript/**/*",
    "src/utils/memory/**/*",
    "src/utils/config/runtime-validation.ts",
    "src/utils/message/clarity-chat-helpers.ts",
    "src/utils/optimization/**/*",
    "src/utils/performance.ts",
    "src/utils/security.ts",
    "src/webhooks/**/*"
  ]
}
