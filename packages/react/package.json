{
  "name": "@clarity-chat/react",
  "version": "1.0.0",
  "type": "module",
  "description": "Premium AI chat components for React - 200+ components, 95+ hooks, enterprise-ready",
  "keywords": [
    "react",
    "chat",
    "ai",
    "chatbot",
    "components",
    "typescript",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "streaming",
    "accessibility",
    "wcag",
    "ui",
    "chat-ui"
  ],
  "homepage": "https://clarity-chat.dev",
  "bugs": {
    "url": "https://github.com/christireid/Clarity-ai-chat-components/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Code & Clarity",
    "email": "hello@codeandclarity.com",
    "url": "https://codeandclarity.com"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./core-minimal": {
      "types": "./dist/core-minimal.d.ts",
      "import": "./dist/core-minimal.js",
      "require": "./dist/core-minimal.cjs"
    },
    "./animations": {
      "types": "./dist/animations/index.d.ts",
      "import": "./dist/animations/index.js",
      "require": "./dist/animations/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "import": "./dist/prompt/index.js",
      "require": "./dist/prompt/index.cjs"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js",
      "require": "./dist/analytics/index.cjs"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "require": "./dist/memory/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./test-utils": {
      "types": "./dist/test-utils.d.ts",
      "import": "./dist/test-utils.js",
      "require": "./dist/test-utils.cjs"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs"
    },
    "./slim": {
      "types": "./dist/slim.d.ts",
      "import": "./dist/slim.js",
      "require": "./dist/slim.cjs"
    },
    "./namespaced": {
      "types": "./dist/namespaced.d.ts",
      "import": "./dist/namespaced.js",
      "require": "./dist/namespaced.cjs"
    },
    "./styles.css": "./dist/styles/index.css",
    "./dist/styles/index.css": "./dist/styles/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christireid/Clarity-ai-chat-components.git",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "node scripts/build-sequential.mjs",
    "build:production": "node scripts/build-production.cjs",
    "build:parallel": "tsup",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "pnpm -C ../license run build && pnpm -C ../memory run build && pnpm -C ../types run build && pnpm -C ../utils run build && pnpm -C ../primitives run build && tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --fix",
    "lint:check": "eslint src --ext ts,tsx",
    "lint:accessibility": "eslint src --ext ts,tsx --rule 'jsx-a11y/*:error'",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --reporter=verbose",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=4096' vitest",
    "test:ui": "NODE_OPTIONS='--max-old-space-size=4096' vitest --ui",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage",
    "test:memory": "NODE_OPTIONS='--max-old-space-size=2048' vitest run",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "peerDependencies": {
    "flowtoken": "^1.0.0",
    "framer-motion": "^12.23.25",
    "mermaid": "^11.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "flowtoken": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "dependencies": {
    "@clarity-chat/license": "workspace:*",
    "@clarity-chat/memory": "workspace:*",
    "@clarity-chat/primitives": "workspace:*",
    "@clarity-chat/token-optimization": "workspace:*",
    "@clarity-chat/types": "workspace:*",
    "@clarity-chat/utils": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-virtual": "^3.11.2",
    "@types/prismjs": "^1.26.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gpt-tokenizer": "^3.4.0",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^2.21.0",
    "js-tiktoken": "^1.0.21",
    "jszip": "^3.10.1",
    "katex": "^0.16.25",
    "lucide-react": "^0.556.0",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.19.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@csstools/css-syntax-patches-for-csstree": "^1.0.15",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@storybook/react": "^10.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.2.0",
    "size-limit": "^12.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
