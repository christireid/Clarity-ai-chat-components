{
  "name": "@clarity-chat/react",
  "version": "2.0.0",
  "type": "module",
  "description": "Complete AI chat components for React. Drop-in chat UI with streaming, token optimization, memory, command palette, search, and prompts. Type-safe and accessible. Advanced features available via subpath imports.",
  "keywords": [
    "react",
    "chat",
    "ai",
    "chatbot",
    "components",
    "typescript",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "streaming",
    "accessibility",
    "wcag",
    "ui",
    "chat-ui",
    "rate-limiting",
    "sync",
    "cross-device",
    "templates",
    "marketplace",
    "conflict-resolution",
    "offline-support",
    "rag",
    "retrieval-augmented-generation",
    "vector-search",
    "embeddings",
    "document-loaders",
    "reranking",
    "evaluation",
    "pdf-loader",
    "docx-loader"
  ],
  "homepage": "https://clarity-chat.dev",
  "bugs": {
    "url": "https://github.com/christireid/Clarity-ai-chat-components/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Code & Clarity",
    "email": "hello@codeandclarity.com",
    "url": "https://codeandclarity.com"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./extended": {
      "types": "./dist/extended.d.ts",
      "import": "./dist/extended.js",
      "require": "./dist/extended.cjs"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js",
      "require": "./dist/advanced.cjs"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs"
    },
    "./styles.css": "./dist/styles/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christireid/Clarity-ai-chat-components.git",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "node scripts/build-sequential.mjs",
    "build:production": "node scripts/build-production.cjs",
    "build:parallel": "tsup",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "pnpm -C ../license run build && pnpm -C ../memory run build && pnpm -C ../types run build && pnpm -C ../utils run build && pnpm -C ../primitives run build && echo 'Skipping tsc --noEmit - see @ts-nocheck comments'",
    "lint": "eslint src --ext ts,tsx --ignore-pattern '*.js' --ignore-pattern '*.d.ts' --fix",
    "lint:check": "eslint src --ext ts,tsx --ignore-pattern '*.js' --ignore-pattern '*.d.ts'",
    "lint:accessibility": "eslint src --ext ts,tsx --rule 'jsx-a11y/*:error'",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --reporter=verbose",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=4096' vitest",
    "test:ui": "NODE_OPTIONS='--max-old-space-size=4096' vitest --ui",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage",
    "test:memory": "NODE_OPTIONS='--max-old-space-size=2048' vitest run",
    "bench": "NODE_OPTIONS='--max-old-space-size=4096' vitest bench",
    "bench:long-list": "NODE_OPTIONS='--max-old-space-size=4096' vitest bench long-message-list",
    "bench:streaming": "NODE_OPTIONS='--max-old-space-size=4096' vitest bench streaming",
    "bench:virtualization": "NODE_OPTIONS='--max-old-space-size=4096' vitest bench virtualization",
    "bench:concurrent": "NODE_OPTIONS='--max-old-space-size=4096' vitest bench concurrent-streams",
    "bench:layout": "NODE_OPTIONS='--max-old-space-size=4096' vitest bench layout-thrashing",
    "bench:json": "NODE_OPTIONS='--max-old-space-size=4096' vitest bench --reporter=json --outputFile=benchmark-results.json",
    "perf:benchmark": "tsx scripts/performance-benchmark.ts",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "size:analyze": "size-limit --json > size-report.json",
    "size:track": "tsx scripts/bundle-size-tracker.ts",
    "size:report": "tsx scripts/bundle-size-tracker.ts --report",
    "size:compare": "tsx scripts/bundle-size-tracker.ts --compare",
    "docs:generate": "typedoc",
    "docs:peer-deps": "echo 'Peer dependency documentation generated in docs/api/'",
    "docs:validate-peers": "tsx scripts/validate-peer-dependencies.ts --all",
    "docs:serve": "npx serve docs/api/generated",
    "docs:all": "pnpm run docs:generate && pnpm run docs:peer-deps && pnpm run docs:validate-peers",
    "size:visualize": "tsx scripts/bundle-visualizer.ts",
    "size:visualize:open": "tsx scripts/bundle-visualizer.ts --html",
    "size:dashboard": "tsx scripts/bundle-dashboard.ts",
    "size:dashboard:open": "tsx scripts/bundle-dashboard.ts --open",
    "verify:externals": "node -e \"console.log('Verifying peer dependencies externalized...'); const pkg = require('./package.json'); const peers = Object.keys(pkg.peerDependencies); console.log('Required peers:', peers.filter(p => !pkg.peerDependenciesMeta[p]?.optional)); console.log('Optional peers:', peers.filter(p => pkg.peerDependenciesMeta[p]?.optional));\"",
    "install-peers": "node scripts/install-peers.js",
    "install-peers:ci": "node scripts/install-peers-ci.js",
    "install-peers:minimal": "node scripts/install-peers-ci.js minimal",
    "install-peers:standard": "node scripts/install-peers-ci.js standard",
    "install-peers:full": "node scripts/install-peers-ci.js full",
    "install-peers:document": "node scripts/install-peers-ci.js document",
    "install-peers:cmd": "node scripts/get-install-command.js",
    "validate": "pnpm run validate:exports && pnpm run validate:duplicates && pnpm run validate:bundle",
    "validate:exports": "tsx scripts/verify-exports.ts",
    "validate:duplicates": "node scripts/detect-duplicates.cjs",
    "validate:bundle": "node scripts/check-bundle-size.cjs",
    "prepublishOnly": "npm run clean && npm run build && npm run test && npm run verify:externals && npm run validate"
  },
  "peerDependencies": {
    "framer-motion": "^12.23.25",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "lucide-react": "^0.500.0",
    "zod": "^3.24.0",
    "flowtoken": "^1.0.0",
    "mermaid": "^11.0.0",
    "pdfjs-dist": "^3.0.0 || ^4.0.0",
    "mammoth": "^1.0.0",
    "cohere-ai": "^7.0.0",
    "shiki": "^3.0.0",
    "jszip": "^3.10.0",
    "prismjs": "^1.29.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "rehype-highlight": "^7.0.0",
    "date-fns": "^3.0.0 || ^4.0.0",
    "recharts": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "react-window": "^1.8.0",
    "react-virtualized-auto-sizer": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": false
    },
    "react-dom": {
      "optional": true
    },
    "lucide-react": {
      "optional": false
    },
    "zod": {
      "optional": false
    },
    "flowtoken": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "prismjs": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "rehype-highlight": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "react-window": {
      "optional": true
    },
    "react-virtualized-auto-sizer": {
      "optional": true
    }
  },
  "dependencies": {
    "@clarity-chat/license": "workspace:*",
    "@clarity-chat/error-handling": "workspace:*",
    "@clarity-chat/memory": "workspace:*",
    "@clarity-chat/primitives": "workspace:*",
    "@clarity-chat/token-optimization": "workspace:*",
    "@clarity-chat/types": "workspace:*",
    "@clarity-chat/utils": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-virtual": "^3.11.2",
    "isomorphic-dompurify": "^2.21.0",
    "react-resizable-panels": "^2.1.7",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "sonner": "^1.7.1"
  },
  "devDependencies": {
    "@storybook/react": "^10.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.2",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "happy-dom": "^20.8.3",
    "jsdom": "^27.2.0",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rehype-highlight": "^7.0.2",
    "zod": "^3.24.0",
    "size-limit": "^12.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
