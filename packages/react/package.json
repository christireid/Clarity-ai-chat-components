{
  "name": "@clarity-chat/react",
  "version": "1.0.0",
  "type": "module",
  "description": "Premium AI chat components for React - 70+ components, 35+ hooks, enterprise-ready",
  "keywords": [
    "react",
    "chat",
    "ai",
    "chatbot",
    "components",
    "typescript",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "streaming",
    "accessibility",
    "wcag",
    "ui",
    "chat-ui"
  ],
  "homepage": "https://clarity-chat.dev",
  "bugs": {
    "url": "https://github.com/christireid/Clarity-ai-chat-components/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Code & Clarity",
    "email": "hello@codeandclarity.com",
    "url": "https://codeandclarity.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "import": "./dist/prompt/index.mjs",
      "require": "./dist/prompt/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./dist/styles/index.css": "./dist/styles/index.css",
    "./components/icons": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christireid/Clarity-ai-chat-components.git",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=4096' vitest",
    "test:ui": "NODE_OPTIONS='--max-old-space-size=4096' vitest --ui",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@clarity-chat/memory": "workspace:*",
    "@clarity-chat/primitives": "workspace:*",
    "@clarity-chat/types": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/prismjs": "^1.26.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.25",
    "highlight.js": "^11.11.1",
    "js-tiktoken": "^1.0.21",
    "jszip": "^3.10.1",
    "katex": "^0.16.25",
    "lucide-react": "^0.556.0",
    "mermaid": "^11.12.2",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@csstools/css-syntax-patches-for-csstree": "^1.0.15",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@storybook/react": "^10.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.2.0",
    "size-limit": "^12.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "size-limit": [
    {
      "name": "Full Bundle (ESM)",
      "path": "dist/index.mjs",
      "limit": "350 KB",
      "gzip": true
    },
    {
      "name": "Full Bundle (CJS)",
      "path": "dist/index.js",
      "limit": "370 KB",
      "gzip": true
    },
    {
      "name": "Single Component Import (Tree-shaken)",
      "path": "dist/index.mjs",
      "import": "{ ChatWindow }",
      "limit": "50 KB",
      "gzip": true
    }
  ]
}
