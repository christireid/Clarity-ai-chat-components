{
  "name": "@clarity-chat/license",
  "version": "1.0.0",
  "description": "License validation for Clarity Chat Pro - AI Chat Component Library",
  "author": "Code & Clarity <hello@codeandclarity.dev>",
  "license": "MIT",
  "homepage": "https://claritychat.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/christireid/Clarity-ai-chat-components.git",
    "directory": "packages/license"
  },
  "bugs": {
    "url": "https://github.com/christireid/Clarity-ai-chat-components/issues"
  },
  "keywords": [
    "clarity-chat",
    "license",
    "react",
    "ai",
    "chat",
    "component-library"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "size": "npm run build && node scripts/check-size.mjs",
    "size:report": "npm run build && node scripts/check-size.mjs --report"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "happy-dom": "^20.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
