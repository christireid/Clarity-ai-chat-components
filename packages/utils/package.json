{
  "name": "@clarity-chat/utils",
  "version": "0.1.0",
  "description": "Shared utility functions for Clarity Chat packages",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js",
      "require": "./dist/format.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "clarity-chat",
    "utilities",
    "format",
    "typescript"
  ],
  "author": "Christi Reid <christi@codeclarity.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/christireid/Clarity-ai-chat-components.git",
    "directory": "packages/utils"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
