{
  "name": "@clarity-chat/dev-tools",
  "version": "0.1.0",
  "description": "Developer tools for debugging, testing, and validation in Clarity Chat",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "clarity-dev": "./dist/cli/index.js"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christireid/Clarity-ai-chat-components.git",
    "directory": "packages/dev-tools"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "cli": "node dist/cli/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch"
  },
  "keywords": [
    "clarity-chat",
    "developer-tools",
    "debugging",
    "testing",
    "validation",
    "cli"
  ],
  "author": "Clarity Chat",
  "license": "MIT",
  "dependencies": {
    "@clarity-chat/errors": "workspace:*",
    "chalk": "^5.6.2",
    "boxen": "^8.0.1",
    "commander": "^12.1.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
