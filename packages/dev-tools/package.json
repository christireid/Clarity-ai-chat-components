{
  "name": "@clarity-chat/dev-tools",
  "version": "1.0.0",
  "type": "module",
  "description": "Premium developer tools for debugging, testing, and validation in Clarity Chat AI applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "import": "./src/styles/dev-tools.css"
    },
    "./styles/dev-tools.css": {
      "import": "./src/styles/dev-tools.css"
    },
    "./styles/modules": {
      "import": "./src/styles/modules/index.css"
    },
    "./styles/modules/*": {
      "import": "./src/styles/modules/*.css"
    }
  },
  "bin": {
    "clarity-dev": "./dist/cli/index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christireid/Clarity-ai-chat-components.git",
    "directory": "packages/dev-tools"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "cli": "node dist/cli/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "clarity-chat",
    "developer-tools",
    "debugging",
    "testing",
    "validation",
    "cli",
    "react-19",
    "ai",
    "performance",
    "profiling"
  ],
  "author": "Clarity Chat",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@clarity-chat/utils": "workspace:*",
    "chalk": "^5.6.2",
    "boxen": "^8.0.1",
    "commander": "^12.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
