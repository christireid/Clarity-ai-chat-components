{
  "name": "@clarity-chat/licensing",
  "version": "0.1.0",
  "description": "License validation and management for Clarity Chat",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christireid/Clarity-ai-chat-components.git",
    "directory": "packages/licensing"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "keywords": [
    "license",
    "validation",
    "commercial",
    "clarity-chat"
  ],
  "author": "Christi Reid <christi@codeclarity.ai>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/christireid/Clarity-ai-chat-components/issues"
  },
  "homepage": "https://github.com/christireid/Clarity-ai-chat-components#readme"
}
