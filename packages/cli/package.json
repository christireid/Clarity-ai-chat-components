{
  "name": "@clarity-chat/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for Clarity Chat - Developer productivity toolkit (experimental - not published in v1)",
  "type": "module",
  "bin": {
    "clarity-chat": "./dist/index.js",
    "@clarity-chat/cli": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Code & Clarity",
    "email": "hello@codeclarity.ai",
    "url": "https://codeclarity.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christireid/Clarity-ai-chat-components.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/christireid/Clarity-ai-chat-components/issues"
  },
  "homepage": "https://github.com/christireid/Clarity-ai-chat-components#readme",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepublishOnly": "npm run build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "clarity-chat",
    "cli",
    "ai",
    "developer-tools",
    "component-library"
  ],
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "boxen": "^7.1.1",
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "execa": "^8.0.1",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "gradient-string": "^2.0.2",
    "handlebars": "^4.7.8",
    "ink": "^6.5.1",
    "ink-gradient": "^3.0.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "open": "^10.0.3",
    "ora": "^8.1.1",
    "picocolors": "^1.0.0",
    "prompts": "^2.4.2",
    "react": "^19.2.0",
    "zod": "^3.22.4",
    "@clarity-chat/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^22.10.5",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "files": [
    "dist",
    "templates",
    "registry.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  }
}
