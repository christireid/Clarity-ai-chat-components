{
  "name": "@clarity-chat/clarity-tokens",
  "version": "1.0.0",
  "description": "AI Token Optimization Library - 80%+ cost reduction through caching, compression, and context management",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./embeddings": {
      "types": "./dist/embeddings.d.ts",
      "import": "./dist/embeddings.js",
      "require": "./dist/embeddings.cjs"
    },
    "./caching": {
      "types": "./dist/caching.d.ts",
      "import": "./dist/caching.js",
      "require": "./dist/caching.cjs"
    },
    "./compression": {
      "types": "./dist/compression.d.ts",
      "import": "./dist/compression.js",
      "require": "./dist/compression.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.8.0",
    "dexie": "^4.0.0",
    "lru-cache": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.0.0",
    "edgevec": "^0.1.0",
    "@mlc-ai/web-llm": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "edgevec": {
      "optional": true
    },
    "@mlc-ai/web-llm": {
      "optional": true
    }
  },
  "keywords": [
    "token-optimization",
    "llm",
    "ai",
    "cost-reduction",
    "semantic-cache",
    "embeddings",
    "compression",
    "context-management",
    "openai",
    "anthropic",
    "gpt-tokenizer"
  ],
  "author": "Clarity Chat Team",
  "license": "MIT"
}
