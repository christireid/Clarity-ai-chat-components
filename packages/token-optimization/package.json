{
  "name": "@clarity-chat/token-optimization",
  "version": "1.0.0",
  "description": "Advanced token optimization system with accurate counting, compression, and security",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.8.0",
    "llm-splitter": "^0.2.0",
    "crypto-js": "^4.2.0",
    "lru-cache": "^10.0.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.1",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "token-optimization",
    "llm",
    "compression",
    "gpt-tokenizer",
    "tokenizer",
    "security",
    "ai",
    "memory"
  ],
  "author": "Clarity Chat Team",
  "license": "MIT"
}
