{
  "name": "@clarity-chat/token-optimization",
  "version": "1.0.0",
  "description": "Count and optimize LLM tokens. Provider-native caching can reduce costs up to 90%*. Works with GPT-4o, Claude, Gemini. Compression, caching, and React hooks included. (*Based on provider pricing specifications. Actual savings depend on cache hit rates and usage patterns.)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./compression": {
      "types": "./dist/compression.d.ts",
      "import": "./dist/compression.js",
      "require": "./dist/compression.cjs"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js",
      "require": "./dist/cache.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext ts,tsx --ignore-pattern '*.js' --ignore-pattern '*.d.ts'",
    "typecheck": "tsc --noEmit",
    "size": "npx bundlephobia-cli ./dist/index.js",
    "doc:check": "tsx scripts/check-doc-sync.ts",
    "doc:sync": "tsx scripts/sync-all-docs.ts",
    "examples:typecheck": "tsc --noEmit examples/*.ts examples/*.tsx 2>/dev/null || true",
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build",
    "precommit": "pnpm typecheck && pnpm doc:check",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@clarity-chat/primitives": "workspace:*",
    "@clarity-chat/utils": "workspace:*",
    "fflate": "^0.8.2",
    "gpt-tokenizer": "^2.8.0",
    "llm-splitter": "^0.2.0",
    "lz-string": "^1.5.0",
    "msgpackr": "^1.11.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.13",
    "@types/validator": "^13.12.0",
    "@vitest/coverage-v8": "^4.0.0",
    "framer-motion": "^12.27.5",
    "jsdom": "^26.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "framer-motion": "^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "framer-motion": {
      "optional": true
    }
  },
  "keywords": [
    "token-optimization",
    "llm",
    "tokens",
    "tokenizer",
    "gpt-tokenizer",
    "caching",
    "prompt-caching",
    "provider-caching",
    "compression",
    "cost-optimization",
    "ai",
    "llm-optimization",
    "react",
    "react-hooks",
    "openai",
    "claude",
    "anthropic",
    "gemini",
    "gpt-4",
    "gpt-4o",
    "security",
    "performance"
  ],
  "author": "Clarity Chat Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clarity-ai/token-optimization.git",
    "directory": "packages/token-optimization"
  },
  "homepage": "https://github.com/clarity-ai/token-optimization#readme",
  "bugs": {
    "url": "https://github.com/clarity-ai/token-optimization/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
