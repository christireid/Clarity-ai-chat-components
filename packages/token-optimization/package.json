{
  "name": "@clarity-chat/token-optimization",
  "version": "1.0.0",
  "description": "Advanced token optimization system with accurate counting, compression, and security",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./compression": {
      "types": "./dist/compression.d.ts",
      "import": "./dist/compression.js",
      "require": "./dist/compression.cjs"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js",
      "require": "./dist/cache.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "size": "npx bundlephobia-cli ./dist/index.js"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.8.0",
    "llm-splitter": "^0.2.0",
    "lru-cache": "^10.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.8",
    "@vitest/coverage-v8": "^4.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "token-optimization",
    "llm",
    "compression",
    "gpt-tokenizer",
    "tokenizer",
    "security",
    "ai",
    "memory",
    "react",
    "openai",
    "claude",
    "gemini"
  ],
  "author": "Clarity Chat Team",
  "license": "MIT"
}
