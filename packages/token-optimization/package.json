{
  "name": "@clarity-chat/token-optimization",
  "version": "1.0.0",
  "description": "Advanced token optimization system with accurate counting, compression, and security",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@tensorflow/tfjs": "^4.15.0",
    "crypto-js": "^4.2.0",
    "lru-cache": "^10.0.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.54.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "token-optimization",
    "llm",
    "compression",
    "tiktoken",
    "security",
    "ai",
    "memory"
  ],
  "author": "Clarity Chat Team",
  "license": "MIT"
}
