# OpenAI API Key (required for embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (optional, for Anthropic embeddings/summarization)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Memory Storage Configuration
# Options: in-memory, file, indexeddb, redis, postgres, sqlite, chroma, qdrant, pinecone, lancedb
MEMORY_STORE_TYPE=in-memory

# File Storage Path (if using file store)
MEMORY_STORE_PATH=./.memory

# Redis Configuration (if using Redis store)
REDIS_URL=redis://localhost:6379

# PostgreSQL Configuration (if using Postgres store)
POSTGRES_URL=postgresql://user:password@localhost:5432/memory

# Vector DB Configuration (if using vector DB)
CHROMA_URL=http://localhost:8000
QDRANT_URL=http://localhost:6333
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east1-gcp

# Token Budget Configuration
MAX_CONTEXT_TOKENS=4000
RESERVE_TOKENS=500

# Debug Mode
DEBUG=false
