{
  "name": "@clarity-chat/memory",
  "version": "0.1.0",
  "description": "Framework-agnostic AI memory and context management utilities",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "example:basic": "tsx examples/basic-usage.ts",
    "example:quick": "tsx examples/quick-start.ts",
    "example:file": "tsx examples/file-storage.ts",
    "example:indexeddb": "echo 'IndexedDB example requires browser environment' && tsx examples/indexeddb-storage.ts",
    "examples": "npm run example:basic",
    "verify": "npm run build && npm run typecheck"
  },
  "keywords": [
    "ai",
    "memory",
    "context",
    "llm",
    "chatbot",
    "token-optimization",
    "semantic-search",
    "vector-store",
    "framework-agnostic",
    "typescript"
  ],
  "author": "Christi Reid <christi@codeclarity.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/christireid/Clarity-ai-chat-components.git",
    "directory": "packages/memory"
  },
  "bugs": {
    "url": "https://github.com/christireid/Clarity-ai-chat-components/issues"
  },
  "homepage": "https://github.com/christireid/Clarity-ai-chat-components#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.9",
    "react": "^19.2.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@clarity-chat/token-optimization": "workspace:*"
  }
}
