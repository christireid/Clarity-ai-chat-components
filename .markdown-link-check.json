{
  "ignorePatterns": [
    {
      "pattern": "^https://claritychat.com"
    },
    {
      "pattern": "^https://codeclarity.ai"
    },
    {
      "pattern": "^https://twitter.com/clarity_chat"
    },
    {
      "pattern": "^mailto:"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "{{BASEURL}}/"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com/"],
      "headers": {
        "Accept": "text/html"
      }
    }
  ],
  "timeout": "5s",
  "retryOn429": true,
  "retryCount": 2,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 301, 302, 307, 308, 403, 405]
}
