      "describe('${1:useHookName}', () => {",
      "  it('${2:test description}', () => {",
      "    const { result } = renderHook(() => ${1:useHookName}(${3:params}))",
      "    ",
      "    expect(result.current.${4:value}).toBe(${5:expected})",
      "  })",
      "",
      "  it('${6:updates correctly}', async () => {",
      "    const { result } = renderHook(() => ${1:useHookName}())",
