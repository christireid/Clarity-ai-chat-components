  "Clarity Chat Component": {
    "prefix": "cc-component",
    "description": "Create a new Clarity Chat component",
    "body": [
      "/**",
      " * ${1:ComponentName} Component",
      " *",
      " * ${2:Component description}",
      " */",
      "",
      "'use client'",
      "",
      "import * as React from 'react'",
      "import { cn } from '@clarity-chat/primitives'",
      "",
      "export interface ${1:ComponentName}Props {",
      "  /** Additional CSS class */",
      "  className?: string",
      "  ${3:// Add props here}",
      "}",
      "",
      "export function ${1:ComponentName}({",
      "  className,",
      "  ${4:...props}",
      "}: ${1:ComponentName}Props) {",
      "  return (",
      "    <div className={cn('${5:base-classes}', className)}>",
      "      ${6:// Component content}",
      "    </div>",
      "  )",
      "}",
      "",
      "${1:ComponentName}.displayName = '${1:ComponentName}'"
    ]
  },

  "Clarity Chat Message Component": {
    "prefix": "cc-message",
    "description": "Create a chat message component",
    "body": [
      "'use client'",
      "",
      "import * as React from 'react'",
      "import { cn } from '@clarity-chat/primitives'",
      "import type { Message } from '@clarity-chat/types'",
      "",
      "export interface ${1:MessageComponentName}Props {",
      "  message: Message",
      "  className?: string",
      "  onEdit?: (id: string, content: string) => void",
      "  onDelete?: (id: string) => void",
      "}",
      "",
      "export function ${1:MessageComponentName}({",
      "  message,",
      "  className,",
      "  onEdit,",
      "  onDelete,",
      "}: ${1:MessageComponentName}Props) {",
      "  const isUser = message.role === 'user'",
      "",
      "  return (",
      "    <div",
      "      className={cn(",
      "        'flex gap-3 p-4 rounded-lg',",
      "        isUser ? 'bg-blue-50' : 'bg-gray-50',",
      "        className",
      "      )}",
      "    >",
      "      <div className=\"flex-1\">",
      "        <p className=\"text-sm text-gray-900\">{message.content}</p>",
      "      </div>",
      "    </div>",
      "  )",
      "}"
    ]
  },

  "Clarity Chat Input Component": {
    "prefix": "cc-input",
    "description": "Create a chat input component",
    "body": [
      "'use client'",
      "",
      "import * as React from 'react'",
      "import { Button, cn } from '@clarity-chat/primitives'",
      "import { Send } from 'lucide-react'",
      "",
      "export interface ${1:ChatInputName}Props {",
      "  onSubmit: (message: string) => void",
      "  disabled?: boolean",
      "  placeholder?: string",
      "  className?: string",
      "}",
      "",
      "export function ${1:ChatInputName}({",
      "  onSubmit,",
      "  disabled = false,",
      "  placeholder = 'Type a message...',",
      "  className,",
      "}: ${1:ChatInputName}Props) {",
      "  const [value, setValue] = React.useState('')",
      "",
      "  const handleSubmit = (e: React.FormEvent) => {",
      "    e.preventDefault()",
      "    if (value.trim() && !disabled) {",
      "      onSubmit(value)",
      "      setValue('')",
      "    }",
      "  }",
      "",
      "  return (",
      "    <form onSubmit={handleSubmit} className={cn('flex gap-2', className)}>",
      "      <input",
      "        type=\"text\"",
      "        value={value}",
      "        onChange={(e) => setValue(e.target.value)}",
      "        placeholder={placeholder}",
      "        disabled={disabled}",
      "        className=\"flex-1 px-4 py-2 border rounded-lg focus:outline-none focus:ring-2\"",
      "      />",
      "      <Button type=\"submit\" disabled={disabled || !value.trim()}>",
      "        <Send className=\"w-4 h-4\" />",
      "      </Button>",
      "    </form>",
      "  )",
      "}"
    ]
  },

