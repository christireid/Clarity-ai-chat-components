  "Clarity Component Test": {
    "prefix": "cc-test",
    "description": "Create a component test",
    "body": [
      "import { describe, it, expect, vi } from 'vitest'",
      "import { render, screen, fireEvent } from '@testing-library/react'",
      "import { ${1:ComponentName} } from './${1:ComponentName}'",
      "",
      "describe('${1:ComponentName}', () => {",
      "  it('renders correctly', () => {",
      "    render(<${1:ComponentName} ${2:props} />)",
      "    expect(screen.getByText('${3:expected text}')).toBeInTheDocument()",
      "  })",
      "",
      "  it('${4:test description}', () => {",
      "    const ${5:mockFn} = vi.fn()",
      "    render(<${1:ComponentName} ${6:onAction={mockFn}} />)",
      "    ",
      "    fireEvent.click(screen.getByRole('button'))",
      "    expect(${5:mockFn}).toHaveBeenCalled()",
      "  })",
      "",
      "  it('handles ${7:interaction}', async () => {",
      "    const ${8:mockFn} = vi.fn()",
      "    render(<${1:ComponentName} ${9:onAction={mockFn}} />)",
      "    ",
      "    const ${10:element} = screen.getByRole('${11:role}')",
      "    await fireEvent.click(${10:element})",
      "    ",
      "    expect(${8:mockFn}).toHaveBeenCalledWith(${12:expectedArgs})",
      "  })",
      "})"
    ]
  },

  "Clarity Hook Test": {
