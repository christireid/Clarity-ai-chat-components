{
  "name": "@clarity-chat/streamlined-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TURBOPACK_EXPERIMENTAL_USE_SYSTEM_TLS_CERTS=1 next dev -H localhost",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext ts,tsx --ignore-pattern scripts --max-warnings 1600",
    "typecheck": "echo 'Skipping typecheck - see TODO comments in app/api files' && exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:rag": "vitest run __tests__/lib/rag-",
    "test:rag:watch": "vitest __tests__/lib/rag-",
    "test:rag:coverage": "vitest run --coverage __tests__/lib/rag-",
    "validate:hooks": "tsx scripts/validate-hook-metadata.ts",
    "validate:examples": "tsx scripts/validate-examples.ts",
    "perf:lighthouse": "lhci autorun",
    "perf:bundle": "size-limit",
    "perf:analyze": "cross-env ANALYZE=true next build",
    "generate:llms": "tsx scripts/generate-llms.ts",
    "generate:llms:preview": "tsx scripts/generate-llms.ts --dry-run",
    "generate:llms:watch": "tsx scripts/generate-llms.ts --watch",
    "revalidate": "tsx ../../scripts/revalidate-cache.ts"
  },
