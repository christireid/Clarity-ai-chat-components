# Enterprise AI Ops - Environment Variables
# Copy this file to .env.local and add your API keys

# OpenAI API Key (for GPT-4, GPT-3.5)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key (for Claude models) - Optional
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google AI API Key (for Gemini models) - Optional
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIza...
