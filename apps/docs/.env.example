# AI Documentation Assistant - Environment Variables
# Copy this file to .env.local and fill in your API keys

# ============================================================================
# REQUIRED: OpenAI API Key
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Used for:
#   - Generating embeddings (text-embedding-3-small)
#   - GPT-4 responses (if using OpenAI as the LLM)
# Cost: ~$0.001 for indexing, ~$0.0015 per query with GPT-4
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ============================================================================
# OPTIONAL: Anthropic API Key (for Claude)
# ============================================================================
# Get your API key from: https://console.anthropic.com/
# Used for: Claude 3.5 Sonnet responses (alternative to GPT-4)
# Cost: ~$0.001 per query (cheaper than GPT-4)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ============================================================================
# OPTIONAL: AI Model Selection
# ============================================================================
# Choose which model to use for generating responses
# Options: 'gpt-4-turbo-preview', 'gpt-4', 'claude-3-5-sonnet-20241022'
# Default: gpt-4-turbo-preview
# AI_MODEL=gpt-4-turbo-preview

# ============================================================================
# PRODUCTION: Pinecone Vector Database
# ============================================================================
# Get your API key from: https://www.pinecone.io/
# Free tier: 1M vectors, 100 namespaces
# Used for: Semantic search across documentation (production)
# For development: Leave empty to use local JSON storage
# PINECONE_API_KEY=your-pinecone-api-key-here
# PINECONE_ENVIRONMENT=us-east-1-aws
# PINECONE_INDEX_NAME=clarity-docs

# ============================================================================
# PRODUCTION: Upstash Redis (Session Storage)
# ============================================================================
# Get your credentials from: https://console.upstash.com/
# Free tier: 10K requests/day
# Used for: Persistent conversation sessions (production)
# For development: Leave empty to use in-memory storage
# UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ============================================================================
# OPTIONAL: Rate Limiting Configuration
# ============================================================================
# Max requests per user per time window
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# Max tokens allowed per request (prevents abuse)
# RATE_LIMIT_MAX_TOKENS=10000

# ============================================================================
# OPTIONAL: Session Configuration
# ============================================================================
# Session key prefix for Redis
# SESSION_PREFIX=clarity-docs-assistant

# Session TTL in seconds (default: 30 days)
# SESSION_TTL=2592000

# ============================================================================
# DEVELOPMENT vs PRODUCTION
# ============================================================================
# NODE_ENV is automatically set by Next.js
# - development: Uses local storage (no Pinecone/Redis needed)
# - production: Uses Pinecone + Redis (requires API keys above)

# ============================================================================
# QUICK START GUIDE
# ============================================================================
#
# For Local Development (Minimal Setup):
# ----------------------------------------
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Add only your OpenAI API key (the only required variable):
#    OPENAI_API_KEY=sk-proj-your-key-here
#
# 3. Install dependencies:
#    pnpm install
#
# 4. Index documentation:
#    pnpm index-docs:dry-run  # Preview what will be indexed
#    pnpm index-docs          # Generate embeddings (~$0.001 cost)
#
# 5. Start development server:
#    pnpm docs
#
# 6. Test the AI assistant:
#    Open http://localhost:3000
#    Click "Ask AI" button (bottom-right)
#    Try: "How do I get started with Clarity Chat?"
#
# ============================================================================
#
# For Production Deployment:
# ---------------------------
# 1. Set up external services:
#    - Upstash Redis: https://console.upstash.com/
#    - Pinecone: https://www.pinecone.io/
#
# 2. Add all API keys above (uncomment and fill in)
#
# 3. Index documentation:
#    pnpm index-docs:clear    # Clear and re-index
#
# 4. Deploy to Vercel:
#    vercel deploy
#
# 5. Add environment variables in Vercel dashboard
#
# ============================================================================
#
# Cost Estimates:
# ---------------
# Development:  ~$0.001 (one-time indexing)
# Production:   ~$15/month (10K queries) or ~$225/month (100K queries)
#
# Free Tiers:
# - Pinecone: 1M vectors
# - Upstash Redis: 10K requests/day
# - Both cover small to medium usage
#
# ============================================================================
