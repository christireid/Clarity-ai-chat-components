{
  "name": "@clarity-chat/storybook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "build:stats": "storybook build --stats-json",
    "clean": "rm -rf storybook-static",
    "preview": "npx http-server storybook-static -p 6007 -o",
    "deploy:vercel": "npm run build && vercel --prod",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=storybook-static",
    "deploy:gh-pages": "npm run build && gh-pages -d storybook-static",
    "analyze": "npm run build:stats && npx vite-bundle-visualizer storybook-static"
  },
  "dependencies": {
    "@clarity-chat/react": "workspace:*",
    "lucide-react": "^0.552.0",
    "framer-motion": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/addon-measure": "^8.4.7",
    "@storybook/addon-outline": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/testing-library": "^0.2.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "storybook": "^8.4.7",
    "storybook-dark-mode": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.0.0"
  }
}
