<Meta title="SDK/Reference" />

const sdkGroups = [
  {
    title: 'Retrieval & Knowledge Base',
    importPath: "@clarity-chat/react/vector-stores",
    module: VectorStores,
    summary: 'Unified interface for Pinecone, Qdrant, Chroma, and in-memory vector stores with helper utilities.',
    bullets: [
      '`createVectorStore` factory + adapters for popular providers.',
      'Helper methods for hybrid search and metadata filters.',
      'Ideal for wiring Clarity into existing retrieval stacks.',
    ],
  },
  {
    title: 'Embeddings Providers',
    importPath: "@clarity-chat/react/embeddings",
    module: Embeddings,
    summary: 'Multi-provider embedding clients with caching, batching, and fallbacks.',
    bullets: [
      '`createEmbeddingProvider` and `createCachedEmbeddingProvider` helpers.',
      'Adapters for OpenAI, Anthropic, Cohere, Vertex, and custom providers.',
      'Model catalog via `COHERE_EMBEDDING_MODELS`, `EmbeddingUtils`.',
    ],
  },
  {
    title: 'Agent Toolkit',
    importPath: "@clarity-chat/react/agents",
    module: Agents,
    summary: 'Composable agent runtime with tool registry and orchestrator utilities.',
    bullets: [
      '`createAgent` orchestrates streaming, tool invocation, and branching logic.',
      'Bundled tools: calculator, code execution harness, HTTP requests, and more.',
      'Integrates with `useChat` + `AgentRunFeed` components.',
    ],
  },
  {
    title: 'Prompt Library',
    importPath: "@clarity-chat/react/prompts",
    module: Prompts,
    summary: 'Templating helpers and canned blueprints for common AI tasks.',
    bullets: [
      '`PromptTemplateLibrary` – curated prompt kits.',
      '`PromptTemplateEngine` – variable interpolation with validation.',
      '`renderPrompt` – final render pipeline with context injection.',
    ],
  },
  {
    title: 'Document Loaders',
    importPath: "@clarity-chat/react/document-loaders",
    module: DocumentLoaders,
    summary: 'Load and split files (PDF, CSV, HTML, JSON, Markdown) for RAG ingestion.',
    bullets: [
      '`LoaderRegistry` – register custom loaders.',
      '`CharacterTextSplitter`, `RecursiveTextSplitter` utilities.',
      'Output ready for vector store ingestion.',
    ],
  },
  {
    title: 'Safety & Guardrails',
    importPath: "@clarity-chat/react/safety",
    module: Safety,
    summary: 'Content filtering, prompt injection detection, and guardrail enforcement.',
    bullets: [
      '`PromptInjectionDetector`, `PIIDetector`, `ContentFilterGuardrail` components.',
      'Composable guardrails for pre- and post-processing.',
    ],
  },
  {
    title: 'Observability & Analytics',
    importPath: "@clarity-chat/react/observability",
    module: Observability,
    summary: 'Tracing, logging, and evaluation primitives.',
    bullets: [
      '`getTracer`/`setTracer` to integrate with OpenTelemetry or custom backends.',
      'Console + Amplitude providers via analytics module.',
    ],
  },
  {
    title: 'Reranking',
    importPath: "@clarity-chat/react/reranking",
    module: Reranking,
    summary: 'Rerank retrieved documents for better answer quality.',
    bullets: [
      '`SimpleReranker` and `DiversityReranker` strategies.',
      'Useful when combining keyword + semantic search.',
    ],
  },
  {
    title: 'Webhooks',
    importPath: "@clarity-chat/react/webhooks",
    module: Webhooks,
    summary: 'Webhook manager and event schema for AI lifecycle monitoring.',
    bullets: [
      '`WebhookManager` orchestrates subscriptions + retries.',
      '`WebhookEvents` enumerates lifecycle triggers.',
    ],
  },
  {
    title: 'Plugins',
    importPath: "@clarity-chat/react/plugins",
    module: Plugins,
    summary: 'Plugin architecture for extending chat capabilities.',
    bullets: [
