    importPath: "@clarity-chat/react/quotas",
    module: Quotas,
    summary: 'Per-tenant or per-user quota tracking with in-memory storage.',
    bullets: [
      '`QuotaManager`, `MemoryQuotaStorage`, and events for exhaustion alerts.',
