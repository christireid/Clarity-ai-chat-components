    importPath: "@clarity-chat/react/audit",
    module: Audit,
    summary: 'Track AI actions for compliance and troubleshooting.',
    bullets: [
      '`AuditLogger` with pluggable storage.',
      '`AuditActions` enum for consistent event semantics.',
    ],
  },
  {
