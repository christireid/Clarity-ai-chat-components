export function HooksTable({ entries }: { entries: (typeof hookCatalog)[number]['entries'] }) {
  return (
    <div className="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
      <table className="w-full border-collapse text-sm">
        <thead className="bg-muted/50 text-left text-xs uppercase tracking-wide text-muted-foreground">
          <tr>
            <th className="px-4 py-3 font-semibold">Hook</th>
            <th className="px-4 py-3 font-semibold">Summary</th>
            <th className="px-4 py-3 font-semibold">Import</th>
          </tr>
        </thead>
        <tbody>
          {entries.map((entry) => (
            <tr key={entry.name} className="border-t border-border/60">
              <td className="px-4 py-3 font-medium">{entry.name}</td>
              <td className="px-4 py-3 text-muted-foreground">
                <div>{entry.summary}</div>
                <div className="mt-2 text-xs font-mono text-muted-foreground/80">
                  exports: {Object.keys(entry.module).slice(0, 6).join(', ')}
                  {Object.keys(entry.module).length > 6 ? '…' : ''}
                </div>
              </td>
              <td className="px-4 py-3 font-mono text-xs text-primary">{entry.importPath}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

<div className="space-y-8">
  <div className="space-y-3">
    <h1 className="text-3xl font-bold">Advanced Hooks Catalog</h1>
    <p className="text-sm text-muted-foreground">
      A reference of specialised hooks that power Clarity’s production chat experiences. Import only what you need – every hook is tree-shakeable and side-effect free until invoked.
    </p>
  </div>

  {hookCatalog.map((group) => (
    <section key={group.title} className="space-y-3">
      <div>
        <h2 className="text-xl font-semibold">{group.title}</h2>
        <p className="text-sm text-muted-foreground">{group.description}</p>
      </div>
      <HooksTable entries={group.entries} />
    </section>
  ))}
</div>
