}

/**
 * Keyboard navigation demo - focus and use arrow keys to navigate.
 */
export const KeyboardNavigation: GridStory = {
  render: () => {
    const [selected, setSelected] =
      React.useState<ModernThemePresetName>('default')

    return (
      <div className="space-y-4">
        <div className="p-4 bg-muted rounded-lg">
          <p className="text-sm font-medium mb-2">Keyboard Controls:</p>
          <ul className="text-sm text-muted-foreground space-y-1">
            <li>
              <kbd className="px-1 py-0.5 bg-background rounded border">
                Tab
              </kbd>{' '}
              to focus the grid
            </li>
            <li>
              <kbd className="px-1 py-0.5 bg-background rounded border">←</kbd>{' '}
              <kbd className="px-1 py-0.5 bg-background rounded border">→</kbd>{' '}
              <kbd className="px-1 py-0.5 bg-background rounded border">↑</kbd>{' '}
              <kbd className="px-1 py-0.5 bg-background rounded border">↓</kbd>{' '}
              to navigate
            </li>
            <li>
              <kbd className="px-1 py-0.5 bg-background rounded border">
                Home
              </kbd>{' '}
              /{' '}
              <kbd className="px-1 py-0.5 bg-background rounded border">
                End
              </kbd>{' '}
              to jump to first/last
            </li>
            <li>
              <kbd className="px-1 py-0.5 bg-background rounded border">
                Enter
              </kbd>{' '}
              or{' '}
              <kbd className="px-1 py-0.5 bg-background rounded border">
                Space
              </kbd>{' '}
              to select
            </li>
          </ul>
        </div>
        <ThemePreviewGrid selectedPreset={selected} onSelect={setSelected} />
        <p className="text-sm text-muted-foreground">
          Selected: <strong>{selected}</strong>
        </p>
      </div>
    )
  },
}

/**
 * Theme selector integration example.
 */
export const ThemeSelectorExample: GridStory = {
  render: () => {
    const [selected, setSelected] =
      React.useState<ModernThemePresetName>('default')
    const [mode, setMode] = React.useState<'light' | 'dark'>('light')

    const handleSelect = (preset: ModernThemePresetName) => {
      setSelected(preset)
      setMode(preset.endsWith('-dark') ? 'dark' : 'light')
    }

    return (
      <div className="border border-border rounded-lg overflow-hidden max-w-2xl">
        <div className="bg-muted px-4 py-3 border-b border-border">
          <h3 className="font-semibold">Theme Settings</h3>
          <p className="text-sm text-muted-foreground">
            Choose a theme preset for your application
          </p>
        </div>
        <div className="p-4 space-y-4">
          <div className="flex gap-4">
            <button
              onClick={() => setMode('light')}
              className={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${
                mode === 'light'
                  ? 'bg-primary text-primary-foreground'
                  : 'bg-muted text-muted-foreground hover:text-foreground'
              }`}
            >
              Light Themes
            </button>
            <button
              onClick={() => setMode('dark')}
              className={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${
                mode === 'dark'
                  ? 'bg-primary text-primary-foreground'
                  : 'bg-muted text-muted-foreground hover:text-foreground'
              }`}
            >
              Dark Themes
            </button>
          </div>
          <ThemePreviewGrid
            selectedPreset={selected}
            onSelect={handleSelect}
            filter={mode}
          />
        </div>
      </div>
    )
  },
}
