{
  "name": "clarity-chat",
  "version": "2.2.0",
  "private": true,
  "description": "Premium AI Chat Component Library - AI SDK Elements Quality with 3.5x More Features",
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npx turbo run dev",
    "build": "npx turbo run build",
    "lint": "npx turbo run lint",
    "lint:fix": "npx turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test": "npx turbo run test",
    "test:watch": "npx turbo run test -- --watch",
    "test:coverage": "npx turbo run test -- --coverage",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "clean": "npx turbo run clean && rm -rf node_modules",
    "storybook": "npm run dev --workspace=@clarity-chat/storybook",
    "storybook:build": "npm run build --workspace=@clarity-chat/storybook",
    "docs": "npm run dev --workspace=@clarity-chat/docs",
    "docs:build": "npm run build --workspace=@clarity-chat/docs",
    "docs:generate": "typedoc",
    "typecheck": "npx turbo run typecheck",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "npx turbo run build && changeset publish",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "analyze": "node scripts/analyze-bundle.js",
    "benchmark": "node scripts/benchmark.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "validate:quick": "npm run lint && npm run typecheck",
    "commit": "cz",
    "prepare": "husky install",
    "postinstall": "npm run prepare"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^18.4.0",
    "@commitlint/config-conventional": "^18.4.0",
    "@eslint/js": "^9.39.1",
    "@size-limit/preset-big-lib": "^11.0.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitest/ui": "^1.0.4",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.9.0",
    "husky": "^8.0.3",
    "jsdom": "^23.0.1",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "size-limit": "^11.0.1",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/christireid/Clarity-ai-chat-components.git"
  },
  "keywords": [
    "react",
    "chat",
    "ai",
    "chatbot",
    "ui",
    "components",
    "typescript",
    "openai",
    "gpt",
    "claude",
    "streaming",
    "accessibility",
    "wcag"
  ],
  "author": "Christi Reid <christi@codeclarity.ai>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/christireid/Clarity-ai-chat-components/issues"
  },
  "homepage": "https://github.com/christireid/Clarity-ai-chat-components#readme",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
