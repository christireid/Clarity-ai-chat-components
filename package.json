{
  "name": "clarity-chat",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Premium AI Chat Component Library by Code & Clarity",
  "packageManager": "pnpm@10.21.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npx turbo run dev",
    "build": "npx turbo run build",
    "lint": "npx turbo run lint",
    "lint:fix": "npx turbo run lint -- --fix",
    "test": "npx turbo run test",
    "test:watch": "npx turbo run test -- --watch",
    "test:coverage": "npx turbo run test -- --coverage",
    "clean": "npx turbo run clean && rm -rf node_modules",
    "storybook": "npm run dev --workspace=@clarity-chat/storybook",
    "storybook:build": "npm run build --workspace=@clarity-chat/storybook",
    "docs": "npm run dev --workspace=@clarity-chat/docs",
    "docs:build": "npm run build --workspace=@clarity-chat/docs-site",
    "docs:generate": "typedoc",
    "index-docs": "tsx scripts/index-docs.ts",
    "index-docs:clear": "tsx scripts/index-docs.ts --clear",
    "index-docs:dry-run": "tsx scripts/index-docs.ts --dry-run",
    "typecheck": "npx turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npx turbo run build && changeset publish",
    "size": "size-limit",
    "analyze": "node tools/scripts/analyze-bundle.js",
    "benchmark": "node tools/scripts/benchmark.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.39.1",
    "@size-limit/preset-big-lib": "^11.0.1",
    "@storybook/builder-vite": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.9.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.4.0",
    "size-limit": "^11.0.1",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/christireid/Clarity-ai-chat-components.git"
  },
  "keywords": [
    "react",
    "chat",
    "ai",
    "chatbot",
    "ui",
    "components",
    "typescript",
    "openai",
    "gpt",
    "claude",
    "streaming",
    "accessibility",
    "wcag"
  ],
  "author": "Christi Reid <christi@codeclarity.ai>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/christireid/Clarity-ai-chat-components/issues"
  },
  "homepage": "https://github.com/christireid/Clarity-ai-chat-components#readme"
}
