{
  "name": "clarity-chat",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Premium AI Chat Component Library for React - Build beautiful AI chat interfaces in minutes",
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "// ======== QUICK START ========": "",
    "// pnpm install && pnpm build && pnpm storybook": "",
    "// === DEVELOPMENT ===": "",
    "dev": "turbo run dev",
    "dev:react": "turbo run dev --filter=@clarity-chat/react",
    "dev:docs": "turbo run dev --filter=@clarity-chat/docs",
    "storybook": "pnpm --filter @clarity-chat/storybook dev",
    "// === BUILD ===": "",
    "build": "NODE_OPTIONS='--max-old-space-size=2048' turbo run build --concurrency=2",
    "build:packages": "NODE_OPTIONS='--max-old-space-size=2048' turbo run build --filter='./packages/*' --concurrency=2",
    "build:sequential": "NODE_OPTIONS='--max-old-space-size=2048' turbo run build --concurrency=1",
    "build:legacy": "NODE_OPTIONS='--max-old-space-size=4096' turbo run build --concurrency=2",
    "storybook:build": "pnpm --filter @clarity-chat/storybook build",
    "// === TESTING ===": "",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' turbo run test",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=4096' turbo run test -- --watch",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' turbo run test -- --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "pnpm --filter @clarity-chat/docs test:smoke",
    "test:smoke:ui": "pnpm --filter @clarity-chat/docs test:smoke:ui",
    "// === CODE QUALITY ===": "",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "// === QUICK CHECKS (run before committing) ===": "",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "// === CODE GENERATORS ===": "",
    "generate": "plop",
    "generate:component": "plop component",
    "generate:hook": "plop hook",
    "generate:context": "plop context",
    "generate:example": "tsx scripts/generate-example.ts",
    "generate:example:interactive": "tsx scripts/generate-example.ts --interactive",
    "// === DOCUMENTATION ===": "",
    "docs": "pnpm --filter @clarity-chat/docs dev",
    "docs:build": "pnpm --filter @clarity-chat/docs build",
    "docs:generate": "typedoc",
    "docs:sync": "pnpm --filter @clarity-chat/docs-sync start sync",
    "docs:sync:dry-run": "pnpm --filter @clarity-chat/docs-sync start sync --dry-run",
    "docs:extract-apis": "pnpm --filter @clarity-chat/docs-sync start extract-apis",
    "docs:generate-docs": "pnpm --filter @clarity-chat/docs-sync start generate-docs",
    "docs:changelog": "pnpm --filter @clarity-chat/docs-sync start generate-changelog",
    "index-docs": "tsx scripts/index-docs.ts",
    "index-docs:clear": "tsx scripts/index-docs.ts --clear",
    "index-docs:dry-run": "tsx scripts/index-docs.ts --dry-run",
    "// === RELEASE ===": "",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "// === UTILITIES ===": "",
    "clean": "turbo run clean && rm -rf node_modules",
    "size": "size-limit",
    "analyze": "node tools/scripts/analyze-bundle.js",
    "bundle-analysis": "tsx scripts/bundle-analysis.ts",
    "benchmark": "node tools/scripts/benchmark.js",
    "test:visual": "playwright test --config=tests/visual/playwright.config.ts",
    "test:visual:update": "playwright test --config=tests/visual/playwright.config.ts --update-snapshots",
    "check:consistency": "tsx scripts/check-consistency.ts",
    "prepare": "husky",
    "// === DX TOOLS ===": "",
    "generate:theme": "tsx scripts/generate-theme.ts",
    "validate:config": "tsx scripts/validate-config.ts",
    "validate:imports": "tsx scripts/validate-imports.ts",
    "generate:component-inventory": "tsx scripts/generate-component-inventory.ts",
    "// === CODE REVIEW ===": "",
    "review": "tsx scripts/code-review.ts",
    "review:security": "tsx scripts/code-review.ts --type security",
    "review:performance": "tsx scripts/code-review.ts --type performance",
    "review:typescript": "tsx scripts/code-review.ts --type typescript",
    "review:tailwind": "tsx scripts/code-review.ts --type tailwind",
    "review:staged": "tsx scripts/code-review.ts --staged",
    "review:check": "tsx scripts/review-checks.ts",
    "review:check:staged": "tsx scripts/review-checks.ts --staged",
    "review:check:fix": "tsx scripts/review-checks.ts --fix",
    "review:check:json": "tsx scripts/review-checks.ts --output json",
    "review:test": "vitest run --config scripts/vitest.config.ts",
    "review:test:watch": "vitest --config scripts/vitest.config.ts",
    "review:sync": "tsx scripts/sync-review-criteria.ts",
    "review:sync:report": "tsx scripts/sync-review-criteria.ts --report",
    "// === SECURITY ===": "",
    "security:audit": "tsx scripts/security-audit.ts",
    "security:audit:json": "tsx scripts/security-audit.ts --format json --output security-report.json",
    "security:audit:markdown": "tsx scripts/security-audit.ts --format markdown --output SECURITY_AUDIT_REPORT.md",
    "// === BUILD OPTIMIZATION ===": "",
    "analyze:circular": "madge --circular --extensions ts,tsx packages/react/src",
    "analyze:circular:graph": "madge --circular --image graph.svg --extensions ts,tsx packages/react/src",
    "analyze:deps": "madge --extensions ts,tsx packages/react/src",
    "analyze:ts-performance": "tsc --noEmit --extendedDiagnostics",
    "analyze:ts-trace": "tsc --generateTrace trace --incremental false",
    "build:optimized": "NODE_OPTIONS='--max-old-space-size=2048' turbo run build --concurrency=2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@size-limit/preset-big-lib": "^12.0.0",
    "@storybook/addon-designs": "^11.1.2",
    "@storybook/builder-vite": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.2",
    "chalk": "^5.6.2",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.2.14",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.3.1",
    "madge": "^8.0.0",
    "only-allow": "^1.2.1",
    "patch-package": "^8.0.0",
    "playwright": "^1.57.0",
    "plop": "^4.0.5",
    "prettier": "^3.7.4",
    "size-limit": "^12.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "@types/react": "19.2.3",
      "@types/react-dom": "19.2.2",
      "js-yaml": ">=4.1.1",
      "esbuild": ">=0.25.0",
      "dompurify": ">=3.2.4",
      "estree-util-value-to-estree": ">=3.3.3",
      "jsondiffpatch": ">=0.7.2",
      "valibot": ">=1.2.0",
      "prismjs@<1.30.0": ">=1.30.0",
      "ai@<5.0.52": ">=5.0.52",
      "qs@<6.14.1": ">=6.14.1",
      "@modelcontextprotocol/sdk@<1.25.2": ">=1.25.2",
      "@remix-run/server-runtime@<=2.17.2": ">=2.17.3",
      "@remix-run/router@<=1.23.1": ">=1.23.2",
      "@remix-run/react@<2.17.3": ">=2.17.3",
      "react-router@>=6.0.0 <6.30.2": ">=6.30.2",
      "diff@<8.0.3": ">=8.0.3",
      "undici": ">=7.18.2",
      "tar@<=7.5.2": ">=7.5.3",
      "lodash": ">=4.17.23",
      "lodash-es": ">=4.17.23",
      "hono": ">=4.11.7",
      "next@>=15.6.0-canary.0 <16.1.5": ">=16.1.5"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/christireid/Clarity-ai-chat-components.git"
  },
  "keywords": [
    "react",
    "chat",
    "ai",
    "chatbot",
    "ui",
    "components",
    "typescript",
    "openai",
    "gpt",
    "claude",
    "streaming",
    "accessibility",
    "wcag"
  ],
  "author": {
    "name": "Code & Clarity",
    "email": "hello@codeandclarity.com",
    "url": "https://codeandclarity.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/christireid/Clarity-ai-chat-components/issues"
  },
  "homepage": "https://github.com/christireid/Clarity-ai-chat-components#readme",
  "dependencies": {
    "dompurify": "^3.3.1",
    "tsx": "^4.21.0"
  }
}
