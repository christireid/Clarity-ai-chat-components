{
  "name": "clarity-chat",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Premium AI Chat Component Library by Code & Clarity",
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "// === DEVELOPMENT ===": "",
    "dev": "turbo run dev",
    "dev:react": "turbo run dev --filter=@clarity-chat/react",
    "dev:docs": "turbo run dev --filter=@clarity-chat/docs",
    "storybook": "pnpm --filter @clarity-chat/storybook dev",
    "// === BUILD ===": "",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "storybook:build": "pnpm --filter @clarity-chat/storybook build",
    "// === TESTING ===": "",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "test:coverage": "turbo run test -- --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "// === CODE QUALITY ===": "",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "// === CODE GENERATORS ===": "",
    "generate": "plop",
    "generate:component": "plop component",
    "generate:hook": "plop hook",
    "generate:context": "plop context",
    "// === DOCUMENTATION ===": "",
    "docs": "pnpm --filter @clarity-chat/docs dev",
    "docs:build": "pnpm --filter @clarity-chat/docs-site build",
    "docs:generate": "typedoc",
    "index-docs": "tsx scripts/index-docs.ts",
    "index-docs:clear": "tsx scripts/index-docs.ts --clear",
    "index-docs:dry-run": "tsx scripts/index-docs.ts --dry-run",
    "// === RELEASE ===": "",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "// === UTILITIES ===": "",
    "clean": "turbo run clean && rm -rf node_modules",
    "size": "size-limit",
    "analyze": "node tools/scripts/analyze-bundle.js",
    "benchmark": "node tools/scripts/benchmark.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "plop": "^4.0.1",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.1",
    "@size-limit/preset-big-lib": "^12.0.0",
    "@storybook/addon-designs": "^11.0.3",
    "@storybook/builder-vite": "^10.1.4",
    "@storybook/react-vite": "^10.1.4",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.1.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "patch-package": "^8.0.0",
    "prettier": "^3.7.4",
    "size-limit": "^12.0.0",
    "storybook-dark-mode": "^3.0.3",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "@types/react": "19.2.3",
      "@types/react-dom": "19.2.2"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/christireid/Clarity-ai-chat-components.git"
  },
  "keywords": [
    "react",
    "chat",
    "ai",
    "chatbot",
    "ui",
    "components",
    "typescript",
    "openai",
    "gpt",
    "claude",
    "streaming",
    "accessibility",
    "wcag"
  ],
  "author": "Christi Reid <christi@codeclarity.ai>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/christireid/Clarity-ai-chat-components/issues"
  },
  "homepage": "https://github.com/christireid/Clarity-ai-chat-components#readme"
}
