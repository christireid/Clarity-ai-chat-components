# Dependencies
node_modules/
.pnp
.pnp.js

# Package manager lockfiles (project uses pnpm)
package-lock.json
yarn.lock

# Testing
coverage/
.nyc_output/
playwright-report/
test-results/

# Production builds
dist/
build/
.next/
out/
storybook-static/

# Turbo
.turbo/

# Environment files
.env
.env*.local
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# IDE
.idea/
*.swp
*.swo
*~
.DS_Store

# VS Code - Allow workspace settings but ignore personal configs
!.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# PM2
.pm2/
ecosystem.config.cjs

# TypeScript build artifacts
*.tsbuildinfo

# ESLint cache
.eslintcache

# TypeScript declaration files in src (generated during build)
packages/*/src/**/*.d.ts
!packages/*/src/**/*.d.cts
!packages/*/src/**/*.d.mts

# Compiled files in tests directory
tests/**/*.js
tests/**/*.d.ts
tests/**/*.js.map
tests/**/*.d.ts.map

# Compiled files in examples src directories
apps/examples/**/src/**/*.js
apps/examples/**/src/**/*.d.ts
apps/examples/**/src/**/*.js.map
apps/examples/**/src/**/*.d.ts.map

# Compiled files in examples app directories (Remix routes, etc.)
apps/examples/**/app/**/*.js
apps/examples/**/app/**/*.d.ts
apps/examples/**/app/**/*.js.map
apps/examples/**/app/**/*.d.ts.map

# Compiled files in docs app directory
apps/docs/app/**/*.js
apps/docs/app/**/*.d.ts
apps/docs/app/**/*.js.map
apps/docs/app/**/*.d.ts.map
apps/docs/components/**/*.js
apps/docs/components/**/*.d.ts
apps/docs/lib/**/*.js
apps/docs/lib/**/*.d.ts

# Storybook story build artifacts (keep source .ts/.tsx/.mdx only)
apps/storybook/stories/**/*.js
apps/storybook/stories/**/*.mjs
apps/storybook/stories/**/*.js.map
apps/storybook/stories/**/*.d.ts
apps/storybook/stories/**/*.d.ts.map

# Package story build artifacts
packages/*/stories/**/*.js
packages/*/stories/**/*.d.ts
packages/*/stories/**/*.js.map
packages/*/stories/**/*.d.ts.map

# Playwright visual diffs (generated)
tests/visual/__diff_output__/

# Compiled config files (generated by tsup/tsc)
**/*.config.d.ts
**/*.config.d.ts.map
**/*.config.js.map
**/vitest.config.js
**/tsup.config.bundled_*.mjs
**/tsup.config.bundled_*.d.mts
**/tsup.config.bundled_*.d.mts.map

# Vitest setup artifacts
**/vitest.setup.d.ts
**/vitest.setup.d.ts.map

# Package examples build artifacts
packages/*/examples/**/*.js
packages/*/examples/**/*.d.ts
packages/*/examples/**/*.js.map
packages/*/examples/**/*.d.ts.map

# Package test build artifacts
packages/*/__tests__/**/*.js
packages/*/__tests__/**/*.d.ts
packages/*/__tests__/**/*.js.map
packages/*/__tests__/**/*.d.ts.map

# Package source build artifacts (compiled .ts files)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map

# CLI template build artifacts (keep source .ts/.tsx only)
packages/cli/templates/**/*.js
packages/cli/templates/**/*.d.ts
packages/cli/templates/**/*.js.map
packages/cli/templates/**/*.d.ts.map

# Backup files
*.backup
*.bak
*.tar.gz
*.zip

# Core dump files
core
**/core
# Exception: prompt system core directory
!**/src/prompt/core/
!**/src/prompt/core/**
# Exception: tool lifecycle core directory
!**/src/core/
!**/src/core/**

# Temporary documentation files (archived)
archive/documentation-overhaul/
.docs-sync/

# Environment files (except templates)
*.env
*.env.*
!.env.example
!*.env.example

# Build reports
build-report.json
-e 
