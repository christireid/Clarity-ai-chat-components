# =============================================================================
# Clarity Chat - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!

# -----------------------------------------------------------------------------
# AI Documentation Assistant (Phase 2)
# -----------------------------------------------------------------------------

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic Claude API Configuration (Alternative/Fallback)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model Selection
# Options: gpt-4-turbo-preview, gpt-4, claude-3-5-sonnet-20241022, claude-3-opus-20240229
AI_MODEL=gpt-4-turbo-preview

# -----------------------------------------------------------------------------
# Vector Database (Pinecone)
# -----------------------------------------------------------------------------
# Create a free account at: https://www.pinecone.io/

PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=clarity-docs

# Alternative: Supabase Vector (PostgreSQL-based)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alternative: Chroma (Self-hosted, open-source)
# For production, always set this explicitly
# CHROMA_ENDPOINT=https://your-chroma-instance.com

# -----------------------------------------------------------------------------
# Session Storage (Upstash Redis)
# -----------------------------------------------------------------------------
# Create a free database at: https://console.upstash.com/

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Session Configuration
SESSION_TTL=2592000  # 30 days in seconds
SESSION_PREFIX=clarity-docs-assistant

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------

RATE_LIMIT_MAX_REQUESTS=100      # Max requests per time window
RATE_LIMIT_WINDOW_MS=60000       # Time window in milliseconds (1 minute)
RATE_LIMIT_MAX_TOKENS=10000      # Max tokens per request

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# -----------------------------------------------------------------------------

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# PostHog (Optional - for usage tracking)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry (Optional - for error tracking)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------

# Enable debug logging
DEBUG_AI_ASSISTANT=false

# Mock AI responses (for development without API keys)
MOCK_AI_RESPONSES=false

# Bypass rate limiting (development only)
DISABLE_RATE_LIMIT=false

# -----------------------------------------------------------------------------
# Production Optimization
# -----------------------------------------------------------------------------

# Enable response caching
ENABLE_AI_CACHE=true
AI_CACHE_TTL=3600  # 1 hour in seconds

# Streaming configuration
ENABLE_STREAMING=true
STREAM_CHUNK_SIZE=20  # tokens per chunk

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://clarity-chat.dev

# JWT secret for session tokens (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# API endpoint authentication (optional)
# API_SECRET_KEY=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable/disable AI assistant
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true

# Enable conversation export
ENABLE_CONVERSATION_EXPORT=true

# Enable feedback collection
ENABLE_FEEDBACK=true

# Enable suggested follow-ups
ENABLE_SUGGESTIONS=true

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
#
# Free Tier Limits:
# - OpenAI: $5 free credit for new accounts
# - Pinecone: 1M vectors free
# - Upstash Redis: 10K requests/day free
# - Anthropic: $5 free credit for new accounts
#
# Estimated Monthly Costs (after free tier):
# - Low usage (1K queries): ~$50/month
# - Medium usage (10K queries): ~$200/month
# - High usage (100K queries): ~$1,500/month
#
# Development Setup:
# 1. Copy this file to .env.local
# 2. Fill in at least OPENAI_API_KEY or ANTHROPIC_API_KEY
# 3. Optional: Set up Pinecone and Upstash for full functionality
# 4. Run: pnpm install && pnpm dev
#
# Production Setup:
# 1. Set all required environment variables in your hosting platform
# 2. Generate strong JWT_SECRET
# 3. Configure CORS_ALLOWED_ORIGINS
# 4. Enable caching and rate limiting
# 5. Set up monitoring (Sentry, PostHog)
#
