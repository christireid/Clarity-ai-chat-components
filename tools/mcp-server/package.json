{
  "name": "@clarity-chat/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Clarity Chat - component discovery, documentation, and code generation for AI chat applications",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "clarity-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "clarity-chat",
    "ai",
    "agents"
  ],
  "author": "Clarity Chat",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
