{
  "name": "clarity-chat",
  "displayName": "Clarity Chat",
  "description": "The ultimate VS Code extension for building AI chat applications. Components, hooks, snippets, and IntelliSense for the Clarity Chat library.",
  "version": "1.0.0",
  "publisher": "code-and-clarity",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/OpenAI-Supported-brightgreen",
      "href": "https://platform.openai.com/docs",
      "description": "OpenAI GPT-4 Support"
    },
    {
      "url": "https://img.shields.io/badge/Anthropic-Supported-brightgreen",
      "href": "https://docs.anthropic.com",
      "description": "Anthropic Claude Support"
    },
    {
      "url": "https://img.shields.io/badge/Google%20AI-Supported-brightgreen",
      "href": "https://ai.google.dev",
      "description": "Google AI Gemini Support"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/code-and-clarity/clarity-chat"
  },
  "bugs": {
    "url": "https://github.com/code-and-clarity/clarity-chat/issues"
  },
  "homepage": "https://claritychat.dev",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "clarity-chat",
    "ai",
    "chat",
    "react",
    "typescript",
    "openai",
    "gpt-4",
    "anthropic",
    "claude",
    "google-ai",
    "gemini",
    "streaming",
    "components",
    "hooks",
    "chatgpt",
    "copilot",
    "llm"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "workspaceContains:**/package.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clarityChat",
          "title": "Clarity Chat",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "clarityChat": [
        {
          "id": "clarityChat.explorer",
          "name": "Explorer",
          "icon": "assets/icon.svg",
          "contextualTitle": "Clarity Chat Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "clarityChat.explorer",
        "contents": "Welcome to Clarity Chat!\n\nBuild stunning AI chat applications with intelligent memory, streaming, and token optimization.\n\n[Get Started](command:clarity-chat.showWelcome)\n[Add Component](command:clarity-chat.addComponent)\n[View Documentation](command:clarity-chat.openDocs)"
      }
    ],
    "commands": [
      {
        "command": "clarity-chat.addComponent",
        "title": "Add Component",
        "category": "Clarity Chat",
        "icon": "$(add)"
      },
      {
        "command": "clarity-chat.addHook",
        "title": "Add Hook",
        "category": "Clarity Chat",
        "icon": "$(symbol-method)"
      },
      {
        "command": "clarity-chat.initProject",
        "title": "Initialize Project",
        "category": "Clarity Chat",
        "icon": "$(folder-opened)"
      },
      {
        "command": "clarity-chat.createApiRoute",
        "title": "Create API Route",
        "category": "Clarity Chat",
        "icon": "$(cloud)"
      },
      {
        "command": "clarity-chat.addProvider",
        "title": "Add Provider",
        "category": "Clarity Chat",
        "icon": "$(plug)"
      },
      {
        "command": "clarity-chat.validateConfig",
        "title": "Validate Configuration",
        "category": "Clarity Chat",
        "icon": "$(check)"
      },
      {
        "command": "clarity-chat.showExamples",
        "title": "Show Examples",
        "category": "Clarity Chat",
        "icon": "$(book)"
      },
      {
        "command": "clarity-chat.showPreview",
        "title": "Component Preview",
        "category": "Clarity Chat",
        "icon": "$(preview)"
      },
      {
        "command": "clarity-chat.manageApiKeys",
        "title": "Manage API Keys",
        "category": "Clarity Chat",
        "icon": "$(key)"
      },
      {
        "command": "clarity-chat.openDocs",
        "title": "Open Documentation",
        "category": "Clarity Chat",
        "icon": "$(book)"
      },
      {
        "command": "clarity-chat.openStorybook",
        "title": "Open Storybook",
        "category": "Clarity Chat",
        "icon": "$(preview)"
      },
      {
        "command": "clarity-chat.convertToClarity",
        "title": "Convert to Clarity Chat",
        "category": "Clarity Chat",
        "icon": "$(sync)"
      },
      {
        "command": "clarity-chat.quickAction",
        "title": "Quick Actions",
        "category": "Clarity Chat",
        "icon": "$(sparkle)"
      },
      {
        "command": "clarity-chat.showWelcome",
        "title": "Show Welcome",
        "category": "Clarity Chat",
        "icon": "$(home)"
      },
      {
        "command": "clarity-chat.refreshExplorer",
        "title": "Refresh Explorer",
        "category": "Clarity Chat",
        "icon": "$(refresh)"
      },
      {
        "command": "clarity-chat.insertSnippet",
        "title": "Insert Snippet",
        "category": "Clarity Chat",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "clarity-chat.addComponent",
          "when": "editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == typescript || editorLangId == javascript"
        },
        {
          "command": "clarity-chat.addHook",
          "when": "editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == typescript || editorLangId == javascript"
        },
        {
          "command": "clarity-chat.createApiRoute",
          "when": "editorLangId == typescript || editorLangId == javascript"
        },
        {
          "command": "clarity-chat.convertToClarity",
          "when": "editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == typescript || editorLangId == javascript"
        }
      ],
      "explorer/context": [
        {
          "command": "clarity-chat.createApiRoute",
          "when": "explorerResourceIsFolder",
          "group": "clarity@1"
        }
      ],
      "editor/context": [
        {
          "command": "clarity-chat.addComponent",
          "when": "editorLangId == typescriptreact || editorLangId == javascriptreact",
          "group": "clarity@1"
        },
        {
          "command": "clarity-chat.convertToClarity",
          "when": "editorLangId == typescriptreact || editorLangId == javascriptreact",
          "group": "clarity@2"
        }
      ]
    },
    "snippets": [
      {
        "language": "typescript",
        "path": "./snippets/typescript.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/react.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/react.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/clarity-components.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/clarity-components.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/clarity-hooks.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/clarity-hooks.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/api-routes.json"
      }
    ],
    "configuration": {
      "title": "Clarity Chat",
      "properties": {
        "clarityChat.enableIntelliSense": {
          "type": "boolean",
          "default": true,
          "description": "Enable IntelliSense completions for Clarity Chat components and hooks"
        },
        "clarityChat.enableHoverDocs": {
          "type": "boolean",
          "default": true,
          "description": "Show documentation on hover for Clarity Chat imports"
        },
        "clarityChat.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens hints for API usage"
        },
        "clarityChat.enableCodeActions": {
          "type": "boolean",
          "default": true,
          "description": "Enable quick fixes and refactoring suggestions"
        },
        "clarityChat.defaultProvider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "google"
          ],
          "default": "openai",
          "description": "Default AI provider for new API routes"
        },
        "clarityChat.snippetPrefix": {
          "type": "string",
          "default": "cc",
          "description": "Prefix for Clarity Chat snippets"
        },
        "clarityChat.showInlineHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inline parameter hints"
        }
      }
    },
    "keybindings": [
      {
        "command": "clarity-chat.addComponent",
        "key": "ctrl+shift+c c",
        "mac": "cmd+shift+c c",
        "when": "editorTextFocus"
      },
      {
        "command": "clarity-chat.addHook",
        "key": "ctrl+shift+c h",
        "mac": "cmd+shift+c h",
        "when": "editorTextFocus"
      },
      {
        "command": "clarity-chat.initProject",
        "key": "ctrl+shift+c i",
        "mac": "cmd+shift+c i",
        "when": "editorTextFocus"
      },
      {
        "command": "clarity-chat.showExamples",
        "key": "ctrl+shift+c e",
        "mac": "cmd+shift+c e",
        "when": "editorTextFocus"
      },
      {
        "command": "clarity-chat.validateConfig",
        "key": "ctrl+shift+c v",
        "mac": "cmd+shift+c v",
        "when": "editorTextFocus"
      },
      {
        "command": "clarity-chat.addProvider",
        "key": "ctrl+shift+c p",
        "mac": "cmd+shift+c p",
        "when": "editorTextFocus"
      },
      {
        "command": "clarity-chat.showPreview",
        "key": "ctrl+shift+c o",
        "mac": "cmd+shift+c o",
        "when": "editorTextFocus"
      },
      {
        "command": "clarity-chat.openDocs",
        "key": "ctrl+shift+c d",
        "mac": "cmd+shift+c d",
        "when": "editorTextFocus"
      }
    ],
    "chatParticipants": [
      {
        "id": "clarity-chat.assistant",
        "fullName": "Clarity Chat",
        "name": "clarity",
        "description": "Your AI chat development assistant. Ask about components, hooks, memory, streaming, and more.",
        "isSticky": true,
        "commands": [
          {
            "name": "component",
            "description": "Get help with Clarity Chat components"
          },
          {
            "name": "hook",
            "description": "Get help with Clarity Chat hooks"
          },
          {
            "name": "memory",
            "description": "Learn about memory management"
          },
          {
            "name": "optimize",
            "description": "Get token optimization tips"
          },
          {
            "name": "migrate",
            "description": "Migrate from other libraries"
          },
          {
            "name": "docs",
            "description": "Open documentation"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:unit": "npm run compile && node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
