{
  "name": "clarity-chat",
  "displayName": "Clarity Chat",
  "description": "IntelliSense, code snippets, and productivity tools for Clarity Chat AI framework",
  "version": "0.1.0",
  "publisher": "clarity-chat",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/OpenAI-Supported-brightgreen",
      "href": "https://platform.openai.com/docs",
      "description": "OpenAI GPT-4 Support"
    },
    {
      "url": "https://img.shields.io/badge/Anthropic-Supported-brightgreen",
      "href": "https://docs.anthropic.com",
      "description": "Anthropic Claude Support"
    },
    {
      "url": "https://img.shields.io/badge/Google%20AI-Supported-brightgreen",
      "href": "https://ai.google.dev",
      "description": "Google AI Gemini Support"
    }
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "clarity-chat",
    "ai",
    "openai",
    "gpt-4",
    "anthropic",
    "claude",
    "google-ai",
    "gemini",
    "chat",
    "completion",
    "llm",
    "chatgpt",
    "copilot"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "workspaceContains:**/clarity-chat.config.js",
    "workspaceContains:**/clarity-chat.config.ts",
    "workspaceContains:.env.local"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clarity-chat.initProject",
        "title": "Clarity Chat: Initialize Project",
        "category": "Clarity Chat"
      },
      {
        "command": "clarity-chat.addProvider",
        "title": "Clarity Chat: Add Provider",
        "category": "Clarity Chat"
      },
      {
        "command": "clarity-chat.validateConfig",
        "title": "Clarity Chat: Validate Configuration",
        "category": "Clarity Chat"
      },
      {
        "command": "clarity-chat.showExamples",
        "title": "Clarity Chat: Show Examples",
        "category": "Clarity Chat"
      },
      {
        "command": "clarity-chat.showPreview",
        "title": "Clarity Chat: Component Preview",
        "category": "Clarity Chat"
      },
      {
        "command": "clarity-chat.manageApiKeys",
        "title": "Clarity Chat: Manage API Keys",
        "category": "Clarity Chat"
      }
    ],
    "snippets": [
      {
        "language": "typescript",
        "path": "./snippets/typescript.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/react.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/react.json"
      }
    ],
    "configuration": {
      "title": "Clarity Chat",
      "properties": {
        "clarity-chat.enableIntelliSense": {
          "type": "boolean",
          "default": true,
          "description": "Enable IntelliSense for Clarity Chat APIs"
        },
        "clarity-chat.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens hints for API usage"
        },
        "clarity-chat.defaultProvider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "google"
          ],
          "default": "openai",
          "description": "Default AI provider for snippets"
        },
        "clarity-chat.showInlineHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inline parameter hints"
        }
      }
    },
    "keybindings": [
      {
        "command": "clarity-chat.initProject",
        "key": "ctrl+shift+c i",
        "mac": "cmd+shift+c i",
        "when": "editorTextFocus"
      },
      {
        "command": "clarity-chat.showExamples",
        "key": "ctrl+shift+c e",
        "mac": "cmd+shift+c e",
        "when": "editorTextFocus"
      },
      {
        "command": "clarity-chat.validateConfig",
        "key": "ctrl+shift+c v",
        "mac": "cmd+shift+c v",
        "when": "editorTextFocus"
      },
      {
        "command": "clarity-chat.addProvider",
        "key": "ctrl+shift+c p",
        "mac": "cmd+shift+c p",
        "when": "editorTextFocus"
      },
      {
        "command": "clarity-chat.showPreview",
        "key": "ctrl+shift+c o",
        "mac": "cmd+shift+c o",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:unit": "npm run compile && node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clarity-chat/clarity-chat"
  },
  "license": "MIT"
}
