{
  "name": "@clarity-chat/docs-sync",
  "version": "0.1.0",
  "description": "Automated documentation synchronization for Clarity Chat",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "docs-sync": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "detect-changes": "node dist/index.js detect-changes",
    "extract-apis": "node dist/index.js extract-apis",
    "generate-docs": "node dist/index.js generate-docs",
    "generate-changelog": "node dist/index.js generate-changelog",
    "sync": "node dist/index.js sync",
    "verify": "node dist/index.js verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .docs-sync-cache"
  },
  "keywords": [
    "docs",
    "documentation",
    "automation",
    "clarity-chat",
    "typescript",
    "api-extraction"
  ],
  "author": "Clarity Chat",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.1",
    "minimatch": "^10.0.1",
    "ora": "^8.1.1",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.5.1",
    "vitest": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
