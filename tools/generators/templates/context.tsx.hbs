// === CONTEXT VALUE ===

export type {{pascalCase name}}ContextValue = {{pascalCase name}}State & {{pascalCase name}}Actions

// === CONTEXT ===

const {{pascalCase name}}Context = createContext<{{pascalCase name}}ContextValue | null>(null)

{{pascalCase name}}Context.displayName = '{{pascalCase name}}Context'

// === PROVIDER ===

export interface {{pascalCase name}}ProviderProps {
  /**
   * Child components
   */
