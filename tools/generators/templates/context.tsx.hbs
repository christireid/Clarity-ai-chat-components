  /**
   * Initial value for the context
   */
  initialValue?: unknown
}

const defaultState: {{pascalCase name}}State = {
  value: null,
  isLoading: false,
  error: null,
}

/**
 * {{pascalCase name}}Provider - {{description}}
 *
 * @example
 * ```tsx
 * function App() {
 *   return (
 *     <{{pascalCase name}}Provider>
