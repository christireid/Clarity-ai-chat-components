import { describe, it, expect } from 'vitest'
import { render, screen } from '@testing-library/react'
import { {{pascalCase name}} } from './{{pascalCase name}}'

describe('{{pascalCase name}}', () => {
  it('should render children correctly', () => {
    render(<{{pascalCase name}}>Test content</{{pascalCase name}}>)

    expect(screen.getByText('Test content')).toBeInTheDocument()
  })

  it('should apply custom className', () => {
    render(
      <{{pascalCase name}} className="custom-class">
        Content
      </{{pascalCase name}}>
    )

    const element = screen.getByText('Content').closest('div')
    expect(element).toHaveClass('custom-class')
    expect(element).toHaveClass('clarity-{{kebabCase name}}')
  })

  it('should forward ref correctly', () => {
    const ref = { current: null }
    render(<{{pascalCase name}} ref={ref}>Content</{{pascalCase name}}>)

    expect(ref.current).toBeInstanceOf(HTMLDivElement)
  })

