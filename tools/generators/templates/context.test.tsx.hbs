import { describe, it, expect } from 'vitest'
import { render, screen, renderHook, act } from '@testing-library/react'
import { {{pascalCase name}}Provider, use{{pascalCase name}} } from '../{{pascalCase name}}Context'

describe('{{pascalCase name}}Context', () => {
  describe('{{pascalCase name}}Provider', () => {
    it('should render children', () => {
      render(
        <{{pascalCase name}}Provider>
          <div>Test child</div>
        </{{pascalCase name}}Provider>
      )

      expect(screen.getByText('Test child')).toBeInTheDocument()
    })

    it('should accept initial value', () => {
      const wrapper = ({ children }: { children: React.ReactNode }) => (
        <{{pascalCase name}}Provider initialValue="initial">
          {children}
        </{{pascalCase name}}Provider>
      )

      const { result } = renderHook(() => use{{pascalCase name}}(), { wrapper })

      expect(result.current.value).toBe('initial')
    })
  })

  describe('use{{pascalCase name}}', () => {
    const wrapper = ({ children }: { children: React.ReactNode }) => (
      <{{pascalCase name}}Provider>{children}</{{pascalCase name}}Provider>
    )

    it('should throw error when used outside provider', () => {
      // Suppress console.error for this test
      const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {})

      expect(() => {
        renderHook(() => use{{pascalCase name}}())
      }).toThrow('use{{pascalCase name}} must be used within a {{pascalCase name}}Provider')

      consoleSpy.mockRestore()
    })

    it('should provide default state', () => {
      const { result } = renderHook(() => use{{pascalCase name}}(), { wrapper })

      expect(result.current.value).toBeNull()
      expect(result.current.isLoading).toBe(false)
      expect(result.current.error).toBeNull()
    })

    it('should update value with setValue', () => {
      const { result } = renderHook(() => use{{pascalCase name}}(), { wrapper })

      act(() => {
        result.current.setValue('new value')
      })

      expect(result.current.value).toBe('new value')
    })

    it('should reset to initial state', () => {
      const customWrapper = ({ children }: { children: React.ReactNode }) => (
        <{{pascalCase name}}Provider initialValue="initial">
          {children}
        </{{pascalCase name}}Provider>
      )

      const { result } = renderHook(() => use{{pascalCase name}}(), {
        wrapper: customWrapper,
      })

      act(() => {
        result.current.setValue('changed')
      })

      expect(result.current.value).toBe('changed')

      act(() => {
        result.current.reset()
      })

      expect(result.current.value).toBe('initial')
    })

    it('should clear error', () => {
      const { result } = renderHook(() => use{{pascalCase name}}(), { wrapper })

      // Manually set an error state for testing
      // In real usage, errors would come from async operations

      act(() => {
        result.current.clearError()
      })

      expect(result.current.error).toBeNull()
    })
  })
})
