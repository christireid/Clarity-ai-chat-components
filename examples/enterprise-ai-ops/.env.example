# =============================================================================
# Enterprise AI Ops Example - Environment Variables
# =============================================================================
# Copy this file to .env.local and configure your settings
# cp .env.example .env.local

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------

# OpenAI - Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic - Get your key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Monitoring & Analytics (Optional)
# -----------------------------------------------------------------------------

# Enable detailed logging
# DEBUG=true

# Analytics endpoint (optional)
# ANALYTICS_ENDPOINT=https://your-analytics.com/api

# Alert webhook (optional - for Slack, Discord, etc.)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# -----------------------------------------------------------------------------
# Database (Optional - for persistence)
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/aiops

# Redis for caching (optional)
# REDIS_URL=redis://localhost:6379
