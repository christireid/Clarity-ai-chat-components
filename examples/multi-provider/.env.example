# Multi-Provider Example - Environment Variables
# ==============================================
# Add API keys for the providers you want to use.
# At least one key is required for the example to work.

# OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google AI API Key
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Note: The example will show which providers are available
# based on which API keys you've configured.
