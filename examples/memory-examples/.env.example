# =============================================================================
# Memory Examples - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your settings
# cp .env.example .env.local

# -----------------------------------------------------------------------------
# AI Provider API Keys (for embedding generation)
# -----------------------------------------------------------------------------

# OpenAI - Required for semantic search with embeddings
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Vector Store Configuration (Optional)
# -----------------------------------------------------------------------------

# Qdrant - For production vector storage
# Local: http://localhost:6333
# Cloud: Get URL from https://cloud.qdrant.io
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-api-key

# Pinecone - Alternative vector store
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_ENVIRONMENT=us-east-1-aws
# PINECONE_INDEX=clarity-memories

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Port for Express/Fastify servers (default: 3000)
PORT=3000

# Enable debug logging
# DEBUG=true

# -----------------------------------------------------------------------------
# Database (Optional - for persistent storage)
# -----------------------------------------------------------------------------

# PostgreSQL for production persistence
# DATABASE_URL=postgresql://user:password@localhost:5432/clarity_memory

# Redis for caching
# REDIS_URL=redis://localhost:6379
