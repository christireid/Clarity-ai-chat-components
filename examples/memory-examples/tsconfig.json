{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@clarity-chat/memory": ["../../packages/memory/src/index"]
    }
  },
  "include": ["*.ts", "*.tsx"],
  "exclude": ["node_modules"]
}
