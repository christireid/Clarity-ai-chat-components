# =============================================================================
# Token Optimization Example - Environment Variables
# =============================================================================
# Copy this file to .env.local and configure your settings
# cp .env.example .env.local

# -----------------------------------------------------------------------------
# AI Provider API Keys
# -----------------------------------------------------------------------------

# OpenAI - Required for accurate tokenization
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic - For Claude model cost calculations
# ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Optional Configuration
# -----------------------------------------------------------------------------

# Default model for cost calculations
# DEFAULT_MODEL=gpt-4o-mini

# Enable debug logging
# DEBUG=true
