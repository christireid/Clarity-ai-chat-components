# Streaming Chat Example - Environment Variables
# ==============================================
# This example has a DEMO MODE that works without API keys!

# OpenAI API Key (optional in demo mode)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Demo Mode - set to "false" to require real API key
# Default: true (works immediately without setup)
DEMO_MODE=true
