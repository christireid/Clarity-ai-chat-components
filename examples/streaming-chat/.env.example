# =============================================================================
# Streaming Chat Example - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your API keys
# cp .env.example .env.local

# -----------------------------------------------------------------------------
# AI Provider API Keys (choose one or more)
# -----------------------------------------------------------------------------

# OpenAI - Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic - Get your key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI - Get your key at https://aistudio.google.com/app/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=...

# -----------------------------------------------------------------------------
# Optional Configuration
# -----------------------------------------------------------------------------

# Default model to use (optional, defaults to gpt-4o-mini)
# DEFAULT_MODEL=gpt-4o-mini

# Enable debug logging (optional)
# DEBUG=true
