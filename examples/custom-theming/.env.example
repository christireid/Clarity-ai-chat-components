# =============================================================================
# Custom Theming Example - Environment Variables
# =============================================================================
# Copy this file to .env.local
# cp .env.example .env.local

# -----------------------------------------------------------------------------
# Optional Configuration
# -----------------------------------------------------------------------------

# This example doesn't require any API keys - it demonstrates theming only.
# The following are optional if you want to add real chat functionality.

# OpenAI - Get your key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Enable debug mode for theme application
# DEBUG=true
