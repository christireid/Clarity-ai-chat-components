# Quickstart Example - Environment Variables
# ============================================
# This example works in DEMO MODE without any API keys!
# Add your OpenAI key below to use real AI responses.

# OpenAI API Key (optional - demo mode works without it)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Demo Mode (set to "false" to require real API key)
# Default: true (works immediately without setup)
DEMO_MODE=true
