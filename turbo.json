{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.local",
    "**/.env.*local",
    "tsconfig.json",
    "eslint.config.js",
    ".prettierrc",
    "packages/typescript-config/**"
  ],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "tsconfig.json"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "storybook-static/**",
        "build/**"
      ],
      "cache": true,
      "env": ["NODE_OPTIONS"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.*", "vitest.setup.*"],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.*", "vitest.setup.*"],
      "outputs": ["coverage/**"],
      "cache": false,
      "env": ["CI"]
    },
    "clean": {
      "cache": false
    },
    "docs-sync": {
      "dependsOn": ["^build"],
      "outputs": [".docs-sync/**", "apps/docs/content/**"],
      "cache": false
    }
  }
}
